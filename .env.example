# 本地医生模型（同时负责检索推理和诊断自省）
TCM_LLM_API_BASE=http://127.0.0.1:5742/v1
TCM_LLM_API_KEY=replace-with-your-local-service-key
TCM_LLM_MODEL=qwen3.5-4b

# 本地 Qwen3-Embedding-4B 检索服务
TCM_EMBEDDING_API_BASE=http://127.0.0.1:6721/v1
TCM_EMBEDDING_API_KEY=replace-with-your-embedding-service-key
TCM_EMBEDDING_MODEL=qwen3-embedding

# 外部患者、助理和专家评分模型；填写账户控制台实际可用的地址和模型名
TCM_SIMULATOR_API_BASE=https://your-endpoint/compatible-mode/v1
TCM_SIMULATOR_API_KEY=replace-with-your-api-key
TCM_SIMULATOR_MODEL=deepseek-v4-flash-0731
